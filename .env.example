# Deriv Bot Environment Variables
# Copy this file to .env and fill in the values

# App Environment (production, staging, development)
APP_ENV=development

# Translation CDN
TRANSLATIONS_CDN_URL=
CROWDIN_BRANCH_NAME=
R2_PROJECT_NAME=

# Analytics
RUDDERSTACK_KEY=
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_DECRYPTION_KEY=

# Monitoring
TRACKJS_TOKEN=
DATADOG_APPLICATION_ID=
DATADOG_CLIENT_TOKEN=
DATADOG_SESSION_SAMPLE_RATE=100
DATADOG_SESSION_REPLAY_SAMPLE_RATE=0

# Google Drive Integration
GD_CLIENT_ID=
GD_APP_ID=
GD_API_KEY=

# Build Reference
REF_NAME=
REMOTE_CONFIG_URL=

# Cloudflare Deployment (GitHub Actions secrets)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_PROJECT_NAME=
# CLOUDFLARE_TEST_LINK_TOKEN=

# Slack Notifications (GitHub Actions secrets)
# SLACK_WEBHOOK=
